# ==========================================
# Root Environment Configuration
# ==========================================

# Obsidian Second Brain GitHub Repository URL
# Examples:
# SSH:   git@github.com:your-user/your-obsidian-second-brain.git
# HTTPS: https://github.com/your-user/your-obsidian-second-brain.git
# Token: https://<TOKEN>@github.com/your-user/your-obsidian-second-brain.git
OBSIDIAN_BRAIN_REPO_URL=git@github.com:vitorecomp/my-second-brain.git

# ==========================================
# YouTube Playlists Crawler (crawlers/youtube-lists)
# ==========================================
# Browser whose logged-in YouTube cookies are used (firefox, chrome, chromium, brave, ...).
# Chromium-based browsers get "+gnomekeyring" appended automatically unless a keyring is given
# (e.g. chrome+basictext). Passing a browser to run.sh overrides this.
YOUTUBE_COOKIES_BROWSER=chrome
# Alternative to the browser: a Netscape-format cookies file (takes precedence when set).
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt
# SQLite database and notes folder; relative paths are relative to the project root.
YOUTUBE_LISTS_DB=data/database/youtube-lists.sqlite
YOUTUBE_LISTS_NOTES_DIR=data/knowledge-data/youtube
# Optional: your channel ID for "Created by me" (auto-detected from Watch Later when unset).
# YOUTUBE_MY_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# Optional: how many videos are fetched at the same time (default 4). Higher is faster but more likely
# to be rate limited by YouTube.
# YOUTUBE_LISTS_WORKERS=4

# ==========================================
# YouTube AI Notes (crawlers/youtube-ai)
# ==========================================
# Gemini API key (https://aistudio.google.com/apikey). Also used by the Hermes Agent (hermes service in
# podman-compose.yml); use a key with billing enabled, the free tier is too small for an agent.
GEMINI_API_KEY=
# Optional settings (defaults shown). Modes: flex (half price, slow), standard (full price),
# priority (1.8x standard, fastest), batch (half price, asynchronous).
# YOUTUBE_AI_MODEL=gemini-3.8-flash
# YOUTUBE_AI_MAX_VIDEOS=0       # 0 = no limit
# YOUTUBE_AI_MODE=flex
# YOUTUBE_AI_WORKERS=4
# YOUTUBE_AI_BATCH_SIZE=50

# ==========================================
# Hermes Agent on Telegram (hermes service in podman-compose.yml)
# ==========================================
# Bot token from @BotFather (/newbot). Anyone with it controls the bot; revoke it there if it leaks.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to talk to the bot (ask @userinfobot for yours).
# Empty = nobody is allowed.
TELEGRAM_ALLOWED_USERS=

# ==========================================
# Hermes Agent on Notion (bundled notion skill)
# ==========================================
# Internal integration key from https://notion.so/my-integrations (starts with ntn_ or secret_).
# Hermes only sees the pages/databases you share with the integration (page menu -> Connect to).
NOTION_API_KEY=

# ==========================================
# Dropbox sync (scripts/sync_dropbox.sh, uses rclone)
# ==========================================
# rclone remote name (create it with `rclone config`) and the folder inside Dropbox.
DROPBOX_REMOTE=dropbox
DROPBOX_PATH=second-brain

