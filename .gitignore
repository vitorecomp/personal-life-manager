# Environment files
.env
.env.*
!.env.example

# Local data (second brain clone, crawler output, SQLite files); only the folder skeleton is tracked
/data/*
!/data/*/
/data/*/*
!/data/*/.gitkeep
# The vault is its own git repository whose .gitignore re-includes *.md and Library/**; nested
# .gitignore rules override these, so the whole folder must be ignored for git not to descend into it.
/data/second-brain/

# Dependency directories
node_modules/
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Build artifacts
dist/
build/
*.egg-info/
bin/
personal-system/backend/server
personal-system/backend/data/*.json

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Secrets and private data (never commit; scripts/git-hooks/pre-commit also blocks them)
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
cookies*.txt
rclone.conf
client_secret*.json
credentials*.json
*.sqlite
*.sqlite3
*.bundle

