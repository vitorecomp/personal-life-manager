# ==========================================
# HERMES // OS - Container Stack Environment
# ==========================================
# When running inside infra-deploy/ without -f, select a single compose file:
COMPOSE_FILE=podman-compose.yml

# PostgreSQL 16 + pgvector
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes
POSTGRES_DB=hermes_os
POSTGRES_PORT=5432

# Redis 7
REDIS_PORT=6379

# Unified Rust + Web SPA Server
HERMES_SERVER_PORT=8080
RUST_LOG=info
HERMES_ADMIN_USER=operator
HERMES_ADMIN_PASSWORD=hermes-os-local
HERMES_BOOTSTRAP_PAT=
REQUIRE_WEB_LOGIN=false

# Nous Research Hermes Gateway (runs on host :8642 when active; server falls back to offline_mock if unreachable)
HERMES_GATEWAY_URL=http://host.containers.internal:8642/v1
HERMES_API_KEY=
